# Copia este archivo como docker/.env y completa los valores.
# docker/.env NO se sube al repositorio.

# --- Acceso a Moodle ---
# Puerto del equipo donde se publica Moodle y su dirección oficial (wwwroot).
# Deben coincidir: si cambias el puerto, cambia también la dirección.
MOODLE_PORT=8080
MOODLE_WWWROOT=http://localhost:8080
# Con ngrok (ngrok http 8080): MOODLE_WWWROOT=https://tu-dominio.ngrok-free.dev
# y MOODLE_SSLPROXY=1
MOODLE_SSLPROXY=

# --- Administrador (se crea en la primera instalación) ---
MOODLE_ADMIN_USER=admin
# Mínimo 8 caracteres con número, minúscula, mayúscula y carácter especial.
MOODLE_ADMIN_PASSWORD=
MOODLE_ADMIN_EMAIL=admin@example.com
MOODLE_SITE_NAME=Auto Evaluar
MOODLE_SITE_SHORTNAME=autoevaluar

# --- Base de datos (solo dentro de Docker) ---
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=120
PDF_DPI=200

# --- Plugin ---
AIOCR_FASTAPI_TIMEOUT=240
# Puerto local para revisar FastAPI (http://127.0.0.1:8000/).
FASTAPI_PORT=8000

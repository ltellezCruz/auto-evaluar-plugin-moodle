# Copia este archivo como .env (en esta misma carpeta) y completa los valores.
# .env NO se sube al repositorio. Las variables de entorno del sistema
# tienen prioridad sobre este archivo.

# --- Moodle ---
# Dirección con la que FastAPI llega a Moodle (en el mismo equipo: http://localhost).
# En Docker, el nombre del servicio de Moodle (ej. http://moodle).
MOODLE_URL=http://localhost
# Dirección pública de Moodle ($CFG->wwwroot), solo si es distinta de MOODLE_URL.
# Los enlaces de los archivos llegan con esta dirección; FastAPI los cambia por
# MOODLE_URL para descargar por dentro y se presenta ante Moodle con este host.
# Con ngrok: MOODLE_PUBLIC_URL=https://tu-dominio.ngrok-free.dev (el PDF ya no
# da la vuelta por internet). En Docker: http://localhost:8080.
# MOODLE_PUBLIC_URL=
# Token del servicio web (Administración del sitio → Servidor → Servicios web → Gestionar tokens).
MOODLE_TOKEN=
# Alternativa: archivo que contiene el token (lo usa Docker).
# MOODLE_TOKEN_FILE=
# Hosts adicionales desde los que se pueden descargar entregas con el token,
# separados por comas. El host de MOODLE_URL siempre está permitido.
# Solo hace falta si no usas MOODLE_PUBLIC_URL.
# ALLOWED_FILE_HOSTS=tu-dominio.ngrok-free.dev

# --- Seguridad ---
# Clave compartida con el plugin: va también en "FastAPI API key" de la
# configuración del plugin en Moodle. Sin ella el servicio rechaza todo (401).
# Genera una larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=
# true muestra la documentación de la API en /docs (solo para desarrollo).
ENABLE_DOCS=false

# --- Gemini ---
# Clave de Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Procesamiento ---
# Resolución al convertir el PDF a imágenes (más alto = más preciso y más costoso).
PDF_DPI=200
# Carpeta donde se guarda la transcripción de cada estudiante.
# Las rutas relativas se resuelven desde fastapi-service/.
OUTPUT_DIR=../data/transcripciones
PROMPTS_DIR=prompts

# --- Límites por solicitud ---
# Tamaño máximo del archivo descargado, páginas por PDF (cada página es una
# llamada a Gemini) y evaluaciones al mismo tiempo (las demás reciben "ocupado").
MAX_FILE_MB=20
MAX_PAGES=20
MAX_CONCURRENT=3

# --- Transcripciones ---
# Se guardan en OUTPUT_DIR/tarea_<id>/usuario_<id>_<fecha>.txt (+ .json con
# tokens, páginas y duración). false = no guardar nada en disco.
SAVE_TRANSCRIPTIONS=true
# Se borran las de más de estos días (0 = nunca).
TRANSCRIPTIONS_DAYS=180

# --- Tiempos de espera (segundos) ---
MOODLE_TIMEOUT=10
DOWNLOAD_TIMEOUT=30
# Por cada llamada a Gemini. Una evaluación hace (páginas + 1) llamadas:
# el timeout del plugin en Moodle debe ser mayor que el total esperado.
GEMINI_TIMEOUT=120
